class SwitchCase2 {
    public static void main() {
        int x = 2;
        System.out.print("x=");
        System.out.print(x);
        System.out.print(": ");
        
        switch (x) {
            case 2:
                System.out.println("Two");
                break;
        }
        
        System.out.println("Done");
    }
}