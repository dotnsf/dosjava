class farr_debug {
    public static void main() {
        float[] arr;
        float f;
        
        arr = new float[3];
        System.out.println(arr.length);
        
        f = 1.5f;
        System.out.println(f);
        
        arr[0] = f;
        System.out.println(arr[0]);
        
        return;
    }
}
