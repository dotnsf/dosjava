// Simple long addition test with debug prints
class TestLongAdd2 {
    public static void main() {
        long a;
        long b;
        
        System.print("Setting a\n");
        a = 1000000L;
        System.print("a set\n");
        
        System.print("Setting b\n");
        b = 2000000L;
        System.print("b set\n");
        
        System.print("a = ");
        System.printLong(a);
        System.print("\n");
        
        System.print("b = ");
        System.printLong(b);
        System.print("\n");
    }
}

