class ftst1 {
    public static void main() {
        float a;
        float b;
        float c;
        
        a = 3.14f;
        b = 2.0f;
        
        c = a + b;
        System.out.println(c);
        
        c = a - b;
        System.out.println(c);
        
        c = a * b;
        System.out.println(c);
        
        c = a / b;
        System.out.println(c);
        
        return;
    }
}
