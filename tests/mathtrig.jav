class mathtrig {
    public static void main() {
        float x;
        float result;
        
        System.out.println("=== Math.sin() ===");
        x = 0.0f;
        result = Math.sin(x);
        System.out.println(result);
        
        x = 1.57f;
        result = Math.sin(x);
        System.out.println(result);
        
        System.out.println("=== Math.cos() ===");
        x = 0.0f;
        result = Math.cos(x);
        System.out.println(result);
        
        x = 1.57f;
        result = Math.cos(x);
        System.out.println(result);
        
        System.out.println("=== Math.tan() ===");
        x = 0.0f;
        result = Math.tan(x);
        System.out.println(result);
        
        x = 0.78f;
        result = Math.tan(x);
        System.out.println(result);
        
        return;
    }
}
