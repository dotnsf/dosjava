class SwitchSimple {
    public static void main() {
        int x;
        
        x = 1;
        switch (x) {
            case 1:
                System.out.println("One");
                break;
            case 2:
                System.out.println("Two");
                break;
            default:
                System.out.println("Other");
                break;
        }
        
        return;
    }
}

