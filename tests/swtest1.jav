class SwitchTest1 {
    public static void main() {
        int x;
        int y;
        
        x = 1;
        y = 1;
        
        System.out.println("Before comparison");
        
        if (x == y) {
            System.out.println("Equal");
        } else {
            System.out.println("Not equal");
        }
        
        System.out.println("After comparison");
        return;
    }
}