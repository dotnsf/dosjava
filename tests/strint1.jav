class strint1 {
    public static void main() {
        int count = 42;
        String msg1 = "Count: " + count;
        String msg2 = count + " items";
        String msg3 = "Total: " + count + " items";
        
        System.out.println(msg1);
        System.out.println(msg2);
        System.out.println(msg3);
    }
}

