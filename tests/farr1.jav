class farr1 {
    public static void main() {
        float[] arr;
        arr = new float[3];
        
        arr[0] = 1.5f;
        arr[1] = 2.5f;
        arr[2] = 3.5f;
        
        System.out.println(arr[0]);
        System.out.println(arr[1]);
        System.out.println(arr[2]);
        
        return;
    }
}
